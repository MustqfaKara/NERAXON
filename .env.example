# Optional local dashboard authentication
NERAXON_ADMIN_PASSWORD=
NERAXON_SESSION_SECRET=

# Secret storage: auto uses macOS Keychain on macOS
NERAXON_SECRET_BACKEND=auto

# Final live execution kill switch
LIVE_TRADING_ENABLED=false

# EVM RPC endpoints
ETHEREUM_RPC_URL=
ETHEREUM_RPC_FALLBACK_URLS=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_FALLBACK_URLS=https://base-rpc.publicnode.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_FALLBACK_URLS=

# Hyperliquid APIs
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_EXCHANGE_URL=https://api.hyperliquid.xyz/exchange

# Solana, Helius, and Jupiter
SOLANA_RPC_URL=
SOLANA_WS_URL=
HELIUS_API_KEY=
JUPITER_API_KEY=
JUPITER_API_URL=https://api.jup.ag/swap/v1
SOLANA_MIN_RESERVE_SOL=0.05
SOLANA_PRIORITY_LEVEL=medium
SOLANA_MAX_PRIORITY_FEE_LAMPORTS=100000

# Execution and market-data providers
ZEROX_API_KEY=
ETHEREUM_SWAP_API_URL=https://api.0x.org
BASE_SWAP_API_URL=https://api.0x.org
LIFI_API_URL=https://li.quest
LIFI_API_KEY=
BIRDEYE_API_KEY=
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
ETHERSCAN_API_KEY=

# Telegram notifications and user-session reader
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI advisory
NERAXON_AI_ADVISOR_ENABLED=true
NERAXON_GROQ_MODEL=openai/gpt-oss-20b

# Optional macOS Keychain account overrides
NERAXON_KEYCHAIN_ACCOUNT=
NERAXON_EVM_KEYCHAIN_ACCOUNT=evm-main
NERAXON_SOLANA_KEYCHAIN_ACCOUNT=solana-main
NERAXON_HYPERLIQUID_KEYCHAIN_ACCOUNT=hyperliquid-agent
NERAXON_TELEGRAM_USER_KEYCHAIN_ACCOUNT=
